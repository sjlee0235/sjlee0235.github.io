rules_version = '2';
// 예비약사 라운지 댓글 보안 규칙: 누구나 읽기·작성 가능, 수정·삭제는 콘솔에서만
service cloud.firestore {
  match /databases/{database}/documents {
    match /comments/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['nick', 'text', 'createdAt'])
        && request.resource.data.nick is string
        && request.resource.data.nick.matches('^.{1,20} 예비약사( [0-9]{1,3})?$')
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 300
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }
    // 닉네임 중복 방지용 (한 번 등록되면 다른 사람이 못 씀)
    match /nicknames/{nick} {
      allow get: if true;
      allow create: if nick.matches('^.{1,20} 예비약사( [0-9]{1,3})?$')
        && request.resource.data.keys().hasOnly(['createdAt'])
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }
  }
}
